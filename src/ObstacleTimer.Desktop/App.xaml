<Application x:Class="ObstacleTimer.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#14202B"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#0B141C"/><Setter Property="Foreground" Value="#EFF6F8"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="#21303D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#364958"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,6,8,6"/><Setter Property="Background" Value="#C0F069"/><Setter Property="Foreground" Value="#122114"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,8,6"/><Setter Property="Foreground" Value="#101820"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EFF6F8"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#14202B"/><Setter Property="Foreground" Value="#E8F0F4"/><Setter Property="RowBackground" Value="#14202B"/><Setter Property="AlternatingRowBackground" Value="#1B2B38"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="RowHeight" Value="40"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263846"/><Setter Property="Foreground" Value="#ADBFCC"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="Foreground" Value="#14202B"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#DDE9F0"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,8,12,8"/><Setter Property="BorderBrush" Value="#314552"/></Style>
 </Application.Resources>
</Application>
