<Window x:Class="ObstacleTimer.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="障碍竞速 · Timy3 多人计时" Width="1420" Height="950" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" Background="#0B141C" Foreground="#EFF6F8" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="OBSTACLE / TIMY3" Foreground="#C0F069" FontWeight="Bold"/><TextBlock Text="集体出发 · 视频躯干终点" FontSize="27" FontWeight="SemiBold" Margin="0,5"/></StackPanel><TextBlock x:Name="ConnectionLabel" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <Border Grid.Row="1" Background="#243325" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="QualityLabel" TextWrapping="Wrap" Foreground="#D9EDAE"/></Border>
  <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabItem Header="多人现场计时"><Grid Margin="0,10,0,0" TextElement.Foreground="#EFF6F8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="查看组次" VerticalAlignment="Center"/><ComboBox x:Name="HeatList" Width="150" DisplayMemberPath="Name" SelectionChanged="HeatSelected"/><TextBlock Text="组名" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="HeatName" Width="100" ToolTip="新组名称（选填）"/><ComboBox x:Name="PrecisionList" Width="100" DisplayMemberPath="Name"/><ComboBox x:Name="RoundingList" Width="80"/><CheckBox x:Name="ProfileConfirmed" Content="已核对设备精度/舍入" VerticalAlignment="Center" Margin="8"/><Button Content="勾选人员 → 准备整组" Click="PrepareGroup"/></WrapPanel>
    <Grid Grid.Row="1" Margin="0,5,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HeatLabel" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RunStatus" TextWrapping="Wrap" Foreground="#ADBFCC" Margin="0,3"/></StackPanel><WrapPanel Grid.Column="1"><Button x:Name="ArmButton" Content="进入待发令（无需先录像）" Click="ArmGroup"/><Button Content="结束本组" Click="CloseGroup" Background="#354654" Foreground="White"/><Button Content="取消未发令组" Click="CancelGroup" Background="#354654" Foreground="White"/></WrapPanel></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="0.85*"/><RowDefinition Height="1.15*"/></Grid.RowDefinitions>
     <GroupBox Header="01 / 勾选本组人员"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="号码" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="BibInput" Width="55" Text="1" ToolTip="号码"/><TextBlock Text="姓名" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="NameInput" Width="100" ToolTip="姓名"/><TextBlock Text="队伍" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="TeamInput" Width="80" ToolTip="队伍（选填）"/><Button Content="添加" Click="AddAthlete"/></WrapPanel><DataGrid Grid.Row="1" x:Name="AthleteGrid"><DataGrid.Columns><DataGridTemplateColumn Header="选" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="号码" Binding="{Binding Athlete.Bib}" Width="65"/><DataGridTextColumn Header="姓名" Binding="{Binding Athlete.Name}" Width="*"/><DataGridTextColumn Header="队伍" Binding="{Binding Athlete.Team}" Width="100"/></DataGrid.Columns></DataGrid></Grid></GroupBox>
     <GroupBox Grid.Column="1" Header="02 / 本组人员（选一人匹配，Ctrl 选两人交换）"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="MemberGrid" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="号码" Binding="{Binding Bib}" Width="65"/><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*" MinWidth="80"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="采用用时" Binding="{Binding Time}" Width="100"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="DNS" Click="DnsRun" Background="#354654" Foreground="White"/><Button Content="DNF" Click="DnfRun" Background="#354654" Foreground="White"/><Button Content="DSQ" Click="DsqRun" Background="#354654" Foreground="White"/><Button Content="恢复选手" Click="RestoreRun" Background="#354654" Foreground="White"/><Button Content="交换两人备份" Click="SwapRuns"/></WrapPanel></Grid></GroupBox>
     <GroupBox Grid.Row="1" Header="03 / 光电门备份队列（绑定号码不会自动采用）"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="FinishGrid"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/><DataGridTextColumn Header="设备终点时刻" Binding="{Binding DeviceTime}" Width="125"/><DataGridTextColumn Header="匹配 / 状态" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="匹配所选号码" Click="AssignEvent"/><Button Content="撤销匹配" Click="UnassignEvent" Background="#354654" Foreground="White"/><Button Content="标记/恢复误按" Click="IgnoreEvent" Background="#354654" Foreground="White"/></WrapPanel><WrapPanel Grid.Row="2"><CheckBox x:Name="MidnightCheck" Content="确认终点为次日" VerticalAlignment="Center" Margin="5"/><Button Content="核验异常事件" Click="ReviewEvent" Background="#354654" Foreground="White"/></WrapPanel></Grid></GroupBox>
     <GroupBox Grid.Row="1" Grid.Column="1" Header="04 / 当前采用成绩（保留两种来源）"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="GroupResults"><DataGrid.Columns><DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="50"/><DataGridTextColumn Header="号码" Binding="{Binding Bib}" Width="65"/><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*" MinWidth="80"/><DataGridTextColumn Header="用时 / 秒" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="视频候选" Binding="{Binding Video}" Width="95"/><DataGridTextColumn Header="光电备份" Binding="{Binding Backup}" Width="95"/><DataGridTextColumn Header="视频−光电" Binding="{Binding Delta}" Width="95"/><DataGridTextColumn Header="采用来源" Binding="{Binding Source}" Width="100"/><DataGridTextColumn Header="判读版本" Binding="{Binding Reviews}" Width="75"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="导出 CSV" Click="Export"/><Button Content="记录录像缺失" Click="RecordingLost" Background="#354654" Foreground="White"/><Button Content="重开组次复核" Click="ReopenGroup" Background="#354654" Foreground="White"/></WrapPanel></Grid></GroupBox>
    </Grid><DockPanel Grid.Row="3" Margin="0,7,0,0"><TextBlock Text="操作原因 / 备注" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="StatusNote" ToolTip="撤销、交换、异常核验等操作必须填写原因"/></DockPanel>
   </Grid></TabItem>
   <TabItem Header="视频候选与来源复核"><Grid Margin="0,12,0,0" TextElement.Foreground="#EFF6F8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><TextBlock Text="查看组次" VerticalAlignment="Center"/><ComboBox x:Name="VisionHeatList" Width="180" DisplayMemberPath="Name" SelectionChanged="VisionHeatSelected"/><Button Content="结束本组" Click="CloseGroup"/></WrapPanel><TextBlock x:Name="VisionPipelineStatus" TextWrapping="Wrap" Foreground="#D9EDAE" Margin="0,4,0,8"/><TextBlock x:Name="VisionEmptyState" TextWrapping="Wrap" Foreground="#FFCD8A" Margin="0,0,0,12"/></StackPanel>
    <DataGrid Grid.Row="1" x:Name="VisionGrid" SelectionChanged="VisionSelected"><DataGrid.Columns><DataGridTextColumn Header="轨迹" Binding="{Binding Track}" Width="95"/><DataGridTextColumn Header="号码" Binding="{Binding Bib}" Width="70"/><DataGridTextColumn Header="候选 / 秒" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="核验状态" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="版本" Binding="{Binding Revision}" Width="55"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2"><TextBlock x:Name="VisionDetails" TextWrapping="Wrap" Foreground="#ADBFCC" Margin="0,8"/><WrapPanel><ComboBox x:Name="VisionRunner" Width="210" DisplayMemberPath="Label"/><Button x:Name="BindVisionButton" Content="绑定视频候选" Click="BindVision"/><Button x:Name="UndoVisionButton" Content="撤销视频绑定" Click="UndoVision"/><Button x:Name="IgnoreVisionButton" Content="忽略此候选" Click="IgnoreVision"/><Button Content="启用已匹配光电门备份" Click="UseBackup"/><Button Content="切回已核验视频" Click="UseCamera"/></WrapPanel><TextBox x:Name="VisionNote" ToolTip="撤销、忽略、切换来源必须填写原因" Margin="0,8"/><TextBlock Text="备注用于上面的来源操作；终点队列匹配备份仍在多人现场计时页操作。" Foreground="#ADBFCC"/></StackPanel>
    <GroupBox Grid.Row="3" Header="实测配置档 / 自动确认门槛"><StackPanel><TextBlock x:Name="ValidationLabel" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ExportDraftButton" Content="导出所选候选配置草稿" Click="ExportValidationDraft"/><Button Content="导入已审核实测配置 JSON" Click="ImportValidation"/><Button Content="打开报告与数据目录" Click="OpenData"/></WrapPanel></StackPanel></GroupBox>
   </Grid></TabItem>
   <TabItem Header="全部成绩与历史"><Grid Margin="0,10,0,0" TextElement.Foreground="#EFF6F8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="旧版估算记录保留来源，不进入硬件计时排名。模拟成绩不进入排名。" Margin="0,5,0,10"/><DataGrid Grid.Row="1" x:Name="ResultsGrid" SelectionChanged="ResultSelected"><DataGrid.Columns><DataGridTextColumn Header="组次" Binding="{Binding Heat}" Width="100"/><DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="50"/><DataGridTextColumn Header="号码" Binding="{Binding Bib}" Width="60"/><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="用时 / 秒" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="成绩版本" Binding="{Binding Revision}" Width="80"/><DataGridTextColumn Header="计时来源" Binding="{Binding Quality}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="RevisionDetails" TextWrapping="Wrap" Foreground="#ADBFCC" Margin="0,8"/></ScrollViewer><WrapPanel><Button Content="导出全部记录" Click="Export"/><Button Content="打开数据目录" Click="OpenData" Background="#354654" Foreground="White"/></WrapPanel></StackPanel></Grid></TabItem>
   <TabItem Header="设备与配对"><Grid Margin="0,15,0,0" TextElement.Foreground="#EFF6F8"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Header="终点手机 / 整组录像"><StackPanel><TextBlock Text="同一 Wi-Fi 扫码。首次按网页指引信任本机证书；网页 v3 支持本地躯干检测、一段原片、多人截图。" TextWrapping="Wrap"/><ComboBox x:Name="AddressList" SelectionChanged="AddressChanged"/><Border Background="White" Width="260" Height="260" HorizontalAlignment="Left" Margin="0,12"><Image x:Name="PairQr"/></Border><TextBox x:Name="PairText" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="先配对手机，无需开启相机即可发令。选手接近终点时，手机手动开启相机并录像。" TextWrapping="Wrap" Foreground="#ADBFCC" Margin="0,12"/></StackPanel></GroupBox><GroupBox Grid.Column="1" Header="Timy3 USB / 原始事件"><StackPanel><TextBlock x:Name="UsbStatus" FontSize="22"/><TextBlock Text="一组一次 START；C1 光电门或 STOP 独立保留备份。视频正常时作为主成绩；采用光电门必须由裁判填写原因并确认。" TextWrapping="Wrap" Margin="0,15"/><TextBox x:Name="RawLine" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="90"/><TextBlock Text="精度和舍入须与 Timy3 核对。软件不修改固件、设备号码、计时参数或清空记录。人工按键反应误差仍然存在。" TextWrapping="Wrap" Foreground="#ADBFCC" Margin="0,15"/><WrapPanel x:Name="SimulationControls" Visibility="Collapsed"><Button Content="模拟 C0 起跑" Click="SimulateStart"/><Button Content="模拟 C1 终点" Click="SimulateFinish"/></WrapPanel></StackPanel></GroupBox></Grid></TabItem>
  </TabControl><TextBlock Grid.Row="3" x:Name="MessageLabel" TextWrapping="Wrap" Foreground="#FFCD8A" Margin="0,10,0,0"/>
 </Grid>
</Window>
